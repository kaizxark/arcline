# Copy this file to .env.local and fill every value in.
# The server refuses to boot if any of these is missing, on purpose,
# so a bad setup fails loudly instead of breaking on the first prompt.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-dummy-key-for-local-dev

# Postgres connection string
DATABASE_URL="file:./dev.db"

# https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy_key_for_local_dev
CLERK_SECRET_KEY=sk_test_dummy_key_for_local_dev

# https://app.posthog.com -> Project settings
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy_key_for_local_dev
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# https://app.arcjet.com -> your site -> SDK key
ARCJET_KEY=ajkey_dummy_key_for_local_dev